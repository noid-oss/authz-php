{
    "name": "noid-oss/authz",
    "description": "PHP SDK for the noid authz contract: token verification, claim hints, live Keto-backed permission checks and a PSR-15 guard.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "symfony/yaml": "Needed only for Manifest::fromYamlFile()",
        "guzzlehttp/guzzle": "A PSR-18 client with a timeout option (any PSR-18 client works)"
    },
    "autoload": {
        "psr-4": { "NoidOss\\Authz\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "NoidOss\\Authz\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "lint": [
            "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
            "@cs",
            "@stan"
        ],
        "vectors:sync": "php scripts/sync-vectors.php",
        "vectors:check": "php scripts/sync-vectors.php --check",
        "check": [ "@lint", "@test" ]
    }
}
